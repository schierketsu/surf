<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Board" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Board">
    <bpmn:participant id="Pool_Main" name="Доска в СППР — основной сценарий: создание из меню" processRef="Process_Main" />
    <bpmn:participant id="Pool_Alt" name="Доска в СППР — альтернативный сценарий: вместе с КС из Оповещатора" processRef="Process_Alt" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet id="Process_Main_lanes">
      <bpmn:lane id="Lane_Duty" name="Дежурный">
        <bpmn:flowNodeRef>M_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_OpenMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ClickNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_PickHistory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Rename</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Settings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ShareLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_MergeOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Manage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Pause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Delete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Board" name="Система «Доска»">
        <bpmn:flowNodeRef>M_CheckRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_HasRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Disabled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ShowPage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_IsActive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_OpenFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_OpenView</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ViewEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_HowJoined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RightsAnon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RightsUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_RightsDuty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_MergeRights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ReadOnly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Paused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_IsOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_DoDelete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Deleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_NoDelete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>M_OpenLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Work</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Администратор">
        <bpmn:flowNodeRef>M_GrantRole</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="M_Start" name="Сотрудник открывает СППР">
      <bpmn:outgoing>MF_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="M_CheckRole" name="Проверить роль сотрудника">
      <bpmn:incoming>MF_01</bpmn:incoming>
      <bpmn:incoming>MF_06</bpmn:incoming>
      <bpmn:outgoing>MF_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_HasRole" name="Роль «Дежурный» или «Администратор»?">
      <bpmn:incoming>MF_02</bpmn:incoming>
      <bpmn:outgoing>MF_03</bpmn:outgoing>
      <bpmn:outgoing>MF_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_Disabled" name="Показать пункт «Доска» в меню неактивным">
      <bpmn:incoming>MF_04</bpmn:incoming>
      <bpmn:outgoing>MF_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="M_GrantRole" name="Выдать сотруднику роль «Дежурный» по запросу">
      <bpmn:incoming>MF_05</bpmn:incoming>
      <bpmn:outgoing>MF_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_OpenMenu" name="Нажать «Доска» в левом меню (под «Аварии»)">
      <bpmn:incoming>MF_03</bpmn:incoming>
      <bpmn:outgoing>MF_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="M_ShowPage" name="Открыть страницу «Доска»: кнопка «Новая доска» и история досок">
      <bpmn:incoming>MF_07</bpmn:incoming>
      <bpmn:outgoing>MF_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Choice" name="Новая доска или из истории?">
      <bpmn:incoming>MF_08</bpmn:incoming>
      <bpmn:outgoing>MF_09</bpmn:outgoing>
      <bpmn:outgoing>MF_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_ClickNew" name="Нажать «Новая доска»">
      <bpmn:incoming>MF_09</bpmn:incoming>
      <bpmn:outgoing>MF_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_PickHistory" name="Выбрать доску в истории">
      <bpmn:incoming>MF_10</bpmn:incoming>
      <bpmn:outgoing>MF_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="M_Create" name="Создать пустую доску «Без названия» с уникальным ID; владелец — дежурный">
      <bpmn:incoming>MF_11</bpmn:incoming>
      <bpmn:outgoing>MF_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_IsActive" name="Доска активна?">
      <bpmn:incoming>MF_12</bpmn:incoming>
      <bpmn:outgoing>MF_14</bpmn:outgoing>
      <bpmn:outgoing>MF_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_Rename" name="Задать название в шапке (обычно INC-номер)">
      <bpmn:incoming>MF_13</bpmn:incoming>
      <bpmn:outgoing>MF_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="M_OpenFull" name="Открыть доску с правами дежурного">
      <bpmn:incoming>MF_14</bpmn:incoming>
      <bpmn:outgoing>MF_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M_OpenView" name="Открыть доску только для просмотра записей">
      <bpmn:incoming>MF_15</bpmn:incoming>
      <bpmn:outgoing>MF_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="M_Settings" name="При необходимости сменить права по умолчанию в настройках доски">
      <bpmn:incoming>MF_17</bpmn:incoming>
      <bpmn:outgoing>MF_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="M_ViewEnd" name="Записи просмотрены">
      <bpmn:incoming>MF_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="M_ShareLink" name="Скопировать ссылку на доску и отправить в чат КС">
      <bpmn:incoming>MF_18</bpmn:incoming>
      <bpmn:outgoing>MF_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_MergeOpen">
      <bpmn:incoming>MF_19</bpmn:incoming>
      <bpmn:incoming>MF_20</bpmn:incoming>
      <bpmn:outgoing>MF_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="M_Split">
      <bpmn:incoming>MF_21</bpmn:incoming>
      <bpmn:outgoing>MF_22</bpmn:outgoing>
      <bpmn:outgoing>MF_23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="M_Manage" name="Вести обсуждение: менять права участников в списке, удалять участников">
      <bpmn:incoming>MF_22</bpmn:incoming>
      <bpmn:outgoing>MF_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M_OpenLink" name="Открыть ссылку на доску">
      <bpmn:incoming>MF_23</bpmn:incoming>
      <bpmn:outgoing>MF_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_HowJoined" name="Как вошёл участник?">
      <bpmn:incoming>MF_24</bpmn:incoming>
      <bpmn:outgoing>MF_25</bpmn:outgoing>
      <bpmn:outgoing>MF_26</bpmn:outgoing>
      <bpmn:outgoing>MF_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_RightsAnon" name="Аноним без входа: только чтение">
      <bpmn:incoming>MF_25</bpmn:incoming>
      <bpmn:outgoing>MF_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M_RightsUser" name="Пользователь с корп. учёткой: права по умолчанию из настроек">
      <bpmn:incoming>MF_26</bpmn:incoming>
      <bpmn:outgoing>MF_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="M_RightsDuty" name="Дежурный или администратор: полное управление доской">
      <bpmn:incoming>MF_27</bpmn:incoming>
      <bpmn:outgoing>MF_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_MergeRights">
      <bpmn:incoming>MF_28</bpmn:incoming>
      <bpmn:incoming>MF_29</bpmn:incoming>
      <bpmn:incoming>MF_30</bpmn:incoming>
      <bpmn:outgoing>MF_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_Work" name="Работать на доске: смотреть или редактировать">
      <bpmn:incoming>MF_31</bpmn:incoming>
      <bpmn:outgoing>MF_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="M_Join">
      <bpmn:incoming>MF_32</bpmn:incoming>
      <bpmn:incoming>MF_33</bpmn:incoming>
      <bpmn:outgoing>MF_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="M_Finish" name="Как завершить работу?">
      <bpmn:incoming>MF_34</bpmn:incoming>
      <bpmn:outgoing>MF_35</bpmn:outgoing>
      <bpmn:outgoing>MF_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M_Pause" name="Приостановить доску (может любой дежурный)">
      <bpmn:incoming>MF_35</bpmn:incoming>
      <bpmn:outgoing>MF_37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="M_ReadOnly" name="Перевести доску в «только чтение»; она остаётся в истории">
      <bpmn:incoming>MF_37</bpmn:incoming>
      <bpmn:outgoing>MF_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="M_Paused" name="Доска приостановлена">
      <bpmn:incoming>MF_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="M_Delete" name="Удалить доску">
      <bpmn:incoming>MF_36</bpmn:incoming>
      <bpmn:outgoing>MF_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_IsOwner" name="Владелец доски или администратор?">
      <bpmn:incoming>MF_39</bpmn:incoming>
      <bpmn:outgoing>MF_40</bpmn:outgoing>
      <bpmn:outgoing>MF_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="M_DoDelete" name="Удалить доску и закрыть доступ по ссылке">
      <bpmn:incoming>MF_40</bpmn:incoming>
      <bpmn:outgoing>MF_42</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="M_Deleted" name="Доска удалена">
      <bpmn:incoming>MF_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="M_NoDelete" name="Чужую доску удалить нельзя">
      <bpmn:incoming>MF_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MF_01" sourceRef="M_Start" targetRef="M_CheckRole" />
    <bpmn:sequenceFlow id="MF_02" sourceRef="M_CheckRole" targetRef="M_HasRole" />
    <bpmn:sequenceFlow id="MF_03" name="Да" sourceRef="M_HasRole" targetRef="M_OpenMenu" />
    <bpmn:sequenceFlow id="MF_04" name="Нет" sourceRef="M_HasRole" targetRef="M_Disabled" />
    <bpmn:sequenceFlow id="MF_05" sourceRef="M_Disabled" targetRef="M_GrantRole" />
    <bpmn:sequenceFlow id="MF_06" sourceRef="M_GrantRole" targetRef="M_CheckRole" />
    <bpmn:sequenceFlow id="MF_07" sourceRef="M_OpenMenu" targetRef="M_ShowPage" />
    <bpmn:sequenceFlow id="MF_08" sourceRef="M_ShowPage" targetRef="M_Choice" />
    <bpmn:sequenceFlow id="MF_09" name="Новая" sourceRef="M_Choice" targetRef="M_ClickNew" />
    <bpmn:sequenceFlow id="MF_10" name="Из истории" sourceRef="M_Choice" targetRef="M_PickHistory" />
    <bpmn:sequenceFlow id="MF_11" sourceRef="M_ClickNew" targetRef="M_Create" />
    <bpmn:sequenceFlow id="MF_12" sourceRef="M_PickHistory" targetRef="M_IsActive" />
    <bpmn:sequenceFlow id="MF_13" sourceRef="M_Create" targetRef="M_Rename" />
    <bpmn:sequenceFlow id="MF_14" name="Да" sourceRef="M_IsActive" targetRef="M_OpenFull" />
    <bpmn:sequenceFlow id="MF_15" name="Нет, приостановлена" sourceRef="M_IsActive" targetRef="M_OpenView" />
    <bpmn:sequenceFlow id="MF_16" sourceRef="M_OpenView" targetRef="M_ViewEnd" />
    <bpmn:sequenceFlow id="MF_17" sourceRef="M_Rename" targetRef="M_Settings" />
    <bpmn:sequenceFlow id="MF_18" sourceRef="M_Settings" targetRef="M_ShareLink" />
    <bpmn:sequenceFlow id="MF_19" sourceRef="M_ShareLink" targetRef="M_MergeOpen" />
    <bpmn:sequenceFlow id="MF_20" sourceRef="M_OpenFull" targetRef="M_MergeOpen" />
    <bpmn:sequenceFlow id="MF_21" sourceRef="M_MergeOpen" targetRef="M_Split" />
    <bpmn:sequenceFlow id="MF_22" sourceRef="M_Split" targetRef="M_Manage" />
    <bpmn:sequenceFlow id="MF_23" sourceRef="M_Split" targetRef="M_OpenLink" />
    <bpmn:sequenceFlow id="MF_24" sourceRef="M_OpenLink" targetRef="M_HowJoined" />
    <bpmn:sequenceFlow id="MF_25" name="Без входа" sourceRef="M_HowJoined" targetRef="M_RightsAnon" />
    <bpmn:sequenceFlow id="MF_26" name="С учёткой" sourceRef="M_HowJoined" targetRef="M_RightsUser" />
    <bpmn:sequenceFlow id="MF_27" name="Дежурный, админ" sourceRef="M_HowJoined" targetRef="M_RightsDuty" />
    <bpmn:sequenceFlow id="MF_28" sourceRef="M_RightsAnon" targetRef="M_MergeRights" />
    <bpmn:sequenceFlow id="MF_29" sourceRef="M_RightsUser" targetRef="M_MergeRights" />
    <bpmn:sequenceFlow id="MF_30" sourceRef="M_RightsDuty" targetRef="M_MergeRights" />
    <bpmn:sequenceFlow id="MF_31" sourceRef="M_MergeRights" targetRef="M_Work" />
    <bpmn:sequenceFlow id="MF_32" sourceRef="M_Work" targetRef="M_Join" />
    <bpmn:sequenceFlow id="MF_33" sourceRef="M_Manage" targetRef="M_Join" />
    <bpmn:sequenceFlow id="MF_34" sourceRef="M_Join" targetRef="M_Finish" />
    <bpmn:sequenceFlow id="MF_35" sourceRef="M_Finish" targetRef="M_Pause" />
    <bpmn:sequenceFlow id="MF_36" sourceRef="M_Finish" targetRef="M_Delete" />
    <bpmn:sequenceFlow id="MF_37" sourceRef="M_Pause" targetRef="M_ReadOnly" />
    <bpmn:sequenceFlow id="MF_38" sourceRef="M_ReadOnly" targetRef="M_Paused" />
    <bpmn:sequenceFlow id="MF_39" sourceRef="M_Delete" targetRef="M_IsOwner" />
    <bpmn:sequenceFlow id="MF_40" name="Да" sourceRef="M_IsOwner" targetRef="M_DoDelete" />
    <bpmn:sequenceFlow id="MF_41" name="Нет" sourceRef="M_IsOwner" targetRef="M_NoDelete" />
    <bpmn:sequenceFlow id="MF_42" sourceRef="M_DoDelete" targetRef="M_Deleted" />
    <bpmn:textAnnotation id="M_NoteHistory">
      <bpmn:text>История — все доски всех дежурных: превью, название (обычно INC-номер), дата, владелец</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="M_NoteHistory_assoc" associationDirection="None" sourceRef="M_ShowPage" targetRef="M_NoteHistory" />
    <bpmn:textAnnotation id="M_NoteDefaults">
      <bpmn:text>Права по умолчанию для присоединившихся: «Только чтение» (по умолчанию) или «Чтение и запись»</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="M_NoteDefaults_assoc" associationDirection="None" sourceRef="M_Settings" targetRef="M_NoteDefaults" />
    <bpmn:textAnnotation id="M_NoteEqual">
      <bpmn:text>У всех дежурных равные права: другой дежурный подключается к доске и тоже управляет ей</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="M_NoteEqual_assoc" associationDirection="None" sourceRef="M_Manage" targetRef="M_NoteEqual" />
    <bpmn:textAnnotation id="M_NoteKeep">
      <bpmn:text>Все, кто присоединялся, сохраняют доступ к доске — только просмотр</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="M_NoteKeep_assoc" associationDirection="None" sourceRef="M_ReadOnly" targetRef="M_NoteKeep" />
  </bpmn:process>
  <bpmn:process id="Process_Alt" isExecutable="false">
    <bpmn:laneSet id="Process_Alt_lanes">
      <bpmn:lane id="Alt_Lane_Duty" name="Дежурный">
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Toggle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Alt_Lane_Notifier" name="Оповещатор">
        <bpmn:flowNodeRef>A_CreateKS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_SendKSOnly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_NoBoard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Alt_Lane_Board" name="Система «Доска»">
        <bpmn:flowNodeRef>A_CreateBoard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_HowJoined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RightsRW</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RightsRO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MergeRights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_BoardFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Alt_Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>A_OpenLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Авария: нужно собрать КС">
      <bpmn:outgoing>AF_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A_Fill" name="Заполнить аварию в Оповещаторе и выбрать участников КС">
      <bpmn:incoming>AF_01</bpmn:incoming>
      <bpmn:outgoing>AF_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A_Toggle" name="Включить тумблер «Доска» в настройках КС">
      <bpmn:incoming>AF_02</bpmn:incoming>
      <bpmn:outgoing>AF_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A_Notify" name="Нажать «Оповестить»">
      <bpmn:incoming>AF_03</bpmn:incoming>
      <bpmn:outgoing>AF_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="A_CreateKS" name="Создать КС">
      <bpmn:incoming>AF_04</bpmn:incoming>
      <bpmn:outgoing>AF_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A_CreateBoard" name="Создать пустую доску: владелец — дежурный, права по умолчанию — чтение и запись">
      <bpmn:incoming>AF_05</bpmn:incoming>
      <bpmn:outgoing>AF_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A_Send" name="Отправить участникам одно сообщение: ссылка на КС и ссылка на доску">
      <bpmn:incoming>AF_06</bpmn:incoming>
      <bpmn:outgoing>AF_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A_SendKSOnly" name="Отправить сообщение только со ссылкой на КС">
      <bpmn:incoming>AF_07</bpmn:incoming>
      <bpmn:outgoing>AF_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="A_NoBoard" name="КС без доски: дежурный создаёт её вручную">
      <bpmn:incoming>AF_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A_OpenLink" name="Открыть ссылку на доску из сообщения">
      <bpmn:incoming>AF_09</bpmn:incoming>
      <bpmn:outgoing>AF_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A_HowJoined" name="Вошёл через корп. учётку?">
      <bpmn:incoming>AF_10</bpmn:incoming>
      <bpmn:outgoing>AF_11</bpmn:outgoing>
      <bpmn:outgoing>AF_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A_RightsRW" name="Права по умолчанию: чтение и запись">
      <bpmn:incoming>AF_11</bpmn:incoming>
      <bpmn:outgoing>AF_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A_RightsRO" name="Аноним без входа: только чтение">
      <bpmn:incoming>AF_12</bpmn:incoming>
      <bpmn:outgoing>AF_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="A_MergeRights">
      <bpmn:incoming>AF_13</bpmn:incoming>
      <bpmn:incoming>AF_14</bpmn:incoming>
      <bpmn:outgoing>AF_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_Work" name="Обсуждать аварию на доске параллельно с КС">
      <bpmn:incoming>AF_15</bpmn:incoming>
      <bpmn:outgoing>AF_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A_End" name="Дальше — как в основном сценарии">
      <bpmn:incoming>AF_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="A_BoardFailed" name="Сбой создания доски" attachedToRef="A_CreateBoard">
      <bpmn:outgoing>AF_07</bpmn:outgoing>
      <bpmn:errorEventDefinition id="A_BoardFailed_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="AF_01" sourceRef="A_Start" targetRef="A_Fill" />
    <bpmn:sequenceFlow id="AF_02" sourceRef="A_Fill" targetRef="A_Toggle" />
