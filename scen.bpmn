    <bpmn:sequenceFlow id="AF_09" sourceRef="A_Send" targetRef="A_OpenLink" />
    <bpmn:sequenceFlow id="AF_10" sourceRef="A_OpenLink" targetRef="A_HowJoined" />
    <bpmn:sequenceFlow id="AF_11" name="Да" sourceRef="A_HowJoined" targetRef="A_RightsRW" />
    <bpmn:sequenceFlow id="AF_12" name="Нет" sourceRef="A_HowJoined" targetRef="A_RightsRO" />
    <bpmn:sequenceFlow id="AF_13" sourceRef="A_RightsRW" targetRef="A_MergeRights" />
    <bpmn:sequenceFlow id="AF_14" sourceRef="A_RightsRO" targetRef="A_MergeRights" />
    <bpmn:sequenceFlow id="AF_15" sourceRef="A_MergeRights" targetRef="A_Work" />
    <bpmn:sequenceFlow id="AF_16" sourceRef="A_Work" targetRef="A_End" />
    <bpmn:textAnnotation id="A_NoteFail">
      <bpmn:text>Сбой создания доски не блокирует КС и оповещение</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_NoteFail_assoc" associationDirection="None" sourceRef="A_SendKSOnly" targetRef="A_NoteFail" />
